{
  "expo": {
    "name": "ConnectU",
    "slug": "connectU",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ConnectU_Logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/ConnectU_Logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connectu.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ConnectU_Logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.connectu.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/images/ConnectU_Logo.png",
      "meta": {
        "name": "google-site-verification",
        "content": "TMl4JHRaMQAPnelWV7jlbleeOqjsPJBki68iiOecC4I"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "http://localhost:8081"
      },
      "eas": {
        "projectId": "c85b7388-2271-4bb7-9c1a-62590674ab6a"
      }
    }
  }
}
